rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;

      match /pushDevices/{deviceId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /roundBackups/{roundId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /appData/{documentId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds;
    }

    match /golfGroups/{groupId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          (
            resource.data.ownerId == request.auth.uid
            && request.auth.uid in request.resource.data.memberIds
          )
          || (
            request.auth.uid in resource.data.memberIds
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['activeStablefordGameId', 'updatedAt'])
          )
          || (
            !(request.auth.uid in resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'updatedAt'])
            && exists(/databases/$(database)/documents/groupInvites/$(groupId + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/groupInvites/$(groupId + '_' + request.auth.uid)).data.toUserId == request.auth.uid
            && get(/databases/$(database)/documents/groupInvites/$(groupId + '_' + request.auth.uid)).data.status == 'pending'
          )
          || (
            request.auth.uid in resource.data.memberIds
            && !(request.auth.uid in request.resource.data.memberIds)
            && resource.data.ownerId != request.auth.uid
            && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'updatedAt'])
          )
        );
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /groupInvites/{inviteId} {
      allow read: if request.auth != null
        && (
          resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
          || get(/databases/$(database)/documents/golfGroups/$(resource.data.groupId)).data.ownerId == request.auth.uid
        );
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow delete: if request.auth != null
        && (
          resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
          || get(/databases/$(database)/documents/golfGroups/$(resource.data.groupId)).data.ownerId == request.auth.uid
        );
    }

    match /sharedRounds/{roundId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /roundNotifications/{notificationId} {
      allow read: if request.auth != null
        && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.actorId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid;
    }

    match /liveFriendRounds/{roundId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /matchplayMatches/{matchId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
    }

    match /liveGroupGames/{gameId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && (
          request.auth.uid in request.resource.data.memberIds
          || (
            !(request.auth.uid in request.resource.data.memberIds)
            && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'updatedAt'])
          )
        );
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      match /players/{playerId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/liveGroupGames/$(gameId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == playerId
          && request.auth.uid in get(/databases/$(database)/documents/liveGroupGames/$(gameId)).data.memberIds;
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/liveGroupGames/$(gameId)).data.memberIds;
      }

      match /events/{eventId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/liveGroupGames/$(gameId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.resource.data.actorId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/liveGroupGames/$(gameId)).data.memberIds;
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/liveGroupGames/$(gameId)).data.memberIds;
      }
    }
  }
}
